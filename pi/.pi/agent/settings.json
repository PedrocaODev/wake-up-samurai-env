{
  "lastChangelogVersion": "0.84.2",
  "theme": "wake-up-samurai",
  "packages": [
    "npm:omniroute-pi-ext-integration",
    "npm:pi-mcp-adapter",
    "npm:@cortexkit/pi-magic-context",
    {
      "source": "../../projects/obsidian-second-brain/dist/pi",
      "prompts": [
        "-.pi/prompts/obsidian-health.md"
      ]
    },
    "git:github.com/DietrichGebert/ponytail",
    "npm:@narumitw/pi-btw",
    "npm:@tintinweb/pi-subagents",
    "npm:@xynogen/pix-sudo"
