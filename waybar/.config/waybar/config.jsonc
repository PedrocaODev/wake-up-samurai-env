{
  "height": 36,
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "layer": "top",
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock", "mpris"],
  "modules-right": ["tray", "cpu", "memory", "group/disk", "pulseaudio", "backlight", "network", "privacy", "battery"],

  "hyprland/workspaces": {
    "all-outputs": true,
    "disable-scroll": false,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": { "1": "一", "2": "二", "3": "三", "4": "四", "5": "五", "6": "六", "7": "七", "8": "八", "9": "九", "10": "十", "active": "侍", "urgent": "!" }
  },
  "hyprland/window": { "format": "{title}", "max-length": 45, "tooltip": true },
  "mpris": {
    "format": "{artist} — {title}", "max-length": 40, "tooltip": true,
    "on-click": "play-pause", "on-click-middle": "previous", "on-click-right": "next",
    "on-scroll-up": "previous", "on-scroll-down": "next",
    "ignored-players": []
  },
  "clock": { "format": "{:%H:%M}", "tooltip": false },
  "tray": { "spacing": 8 },
  "cpu": { "format": " {usage}%", "tooltip": true },
  "memory": { "format": " {percentage}%", "tooltip": true },
  "group/disk": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 250, "click-to-reveal": false },
    "modules": ["disk"]
  },
  "disk": { "format": " {percentage_used}%", "path": "/", "tooltip": true },
  "pulseaudio": {
    "format": " {volume}%", "format-muted": " muted",
    "on-click": "pavucontrol", "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+", "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-", "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "backlight": { "format": " {percent}%" },
  "network": {
    "interface": "^(wlp0s20f3|enp3s0)$", "format-wifi": " {essid}", "format-ethernet": "󰈀 {ipaddr}", "format-disconnected": " off", "on-click": "nm-connection-editor", "tooltip": true
  },
  "privacy": { "icon-spacing": 4, "tooltip": true },
  "battery": { "format": " {capacity}%", "tooltip": true }
}
